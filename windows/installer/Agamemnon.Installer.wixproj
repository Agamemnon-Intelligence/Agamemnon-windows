<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- Built on Windows only (WiX needs msi.dll):
         dotnet build installer -c Release -p:PublishDir=<publish folder>\ -p:Version=1.2.3
       build/package.ps1 does the publish, fetches the engines, signs and builds this. -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <OutputName>Agamemnon-$(Version)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(Version)</DefineConstants>
    <SuppressValidation>false</SuppressValidation>
    <!-- ICE38/43/57: the package is perMachine, so ProgramMenuFolder is the all-users Start menu and an
         HKLM key path is right; these ICEs assume a per-user profile folder.
         ICE60: some bundled third-party DLLs carry a version but no language.
         ICE69: the shortcut targets Agamemnon.exe from another component in the same feature. -->
    <SuppressIces>ICE38;ICE43;ICE57;ICE60;ICE69</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>
</Project>
