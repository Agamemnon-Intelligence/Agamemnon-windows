<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!--
    Agamemnon for Windows: per-machine MSI.

    Installs
      Program Files\Agamemnon\           app, service, bundled ClamAV and YARA engines, rules
      Agamemnon service                  LocalSystem: encrypted DNS, administrator-rights alerts
      AgamemnonScanEngine service        LocalService: ClamAV daemon + signature updates
      %ProgramData%\Agamemnon\           service state, readable and writable by SYSTEM and administrators only
                         \ClamAV\        signatures; also writable by the LocalService scan engine

    The UAC prompt for this installer is the one-time approval for system-wide encrypted DNS
    (the Windows counterpart of approving Agamemnon's DNS settings in macOS System Settings).
    Uninstalling restores every network adapter's DNS settings to what they were before.
  -->
  <Package Name="Agamemnon"
           Manufacturer="Agamemnon contributors"
           Version="$(ProductVersion)"
           UpgradeCode="6783AA51-C693-4AFE-A7AE-40151FA63332"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Agamemnon is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Launch Condition="Installed OR VersionNT64 &gt;= 603" Message="Agamemnon needs 64-bit Windows 10 or later." />

    <Icon Id="AgamemnonIcon" SourceFile="..\src\Agamemnon.App\Assets\agamemnon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AgamemnonIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Agamemnon-Intelligence/Agamemnon-Windows" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Agamemnon-Intelligence/Agamemnon-Windows" />

    <!-- Installer UI: license (GPL-2.0) then progress; offers to start Agamemnon at the end. -->
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start Agamemnon" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#AgamemnonExe]" />
    <CustomAction Id="LaunchAgamemnon" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchAgamemnon"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Agamemnon" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataFolder" Name="Agamemnon">
        <Directory Id="ClamAvDataFolder" Name="ClamAV" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Agamemnon" Level="1">
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentGroupRef Id="Services" />
      <ComponentGroupRef Id="MachineData" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="EventLogSource" />
    </Feature>

    <!-- Everything published, except the two executables declared explicitly below. -->
    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)**">
        <Exclude Files="$(PublishDir)Agamemnon.exe" />
        <Exclude Files="$(PublishDir)Agamemnon.Service.exe" />
        <Exclude Files="$(PublishDir)**\*.pdb" />
        <Exclude Files="$(PublishDir)**\*.lib" />
      </Files>
      <Component Id="AgamemnonApp">
        <File Id="AgamemnonExe" Source="$(PublishDir)Agamemnon.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Services" Directory="INSTALLFOLDER">
      <Component Id="ServiceExecutable">
        <File Id="ServiceExe" Source="$(PublishDir)Agamemnon.Service.exe" KeyPath="yes" />

        <ServiceInstall Id="AgamemnonService"
                        Name="Agamemnon"
                        DisplayName="Agamemnon Protection"
                        Description="Applies Agamemnon's encrypted DNS settings and reports programs that gain administrator rights."
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="5" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="AgamemnonServiceControl" Name="Agamemnon" Start="install" Stop="both" Remove="uninstall" Wait="yes" />

        <ServiceInstall Id="AgamemnonScanEngine"
                        Name="AgamemnonScanEngine"
                        DisplayName="Agamemnon Scan Engine"
                        Description="Runs the ClamAV scanning engine for Agamemnon and keeps its malware signatures up to date."
                        Arguments="--role scan-engine"
                        Type="ownProcess" Start="auto" ErrorControl="normal" Account="NT AUTHORITY\LocalService" Vital="yes">
          <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="10" ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl Id="AgamemnonScanEngineControl" Name="AgamemnonScanEngine" Start="install" Stop="both" Remove="uninstall" Wait="no" />
      </Component>
    </ComponentGroup>

    <!-- Service state: SYSTEM and administrators only. ClamAV signatures: plus LocalService (modify). -->
    <ComponentGroup Id="MachineData">
      <Component Id="DataFolderAcl" Directory="DataFolder" Guid="7E0B6C0B-6E8A-4E59-9C61-0B9C3F3B9A11">
        <CreateFolder>
          <PermissionEx Sddl="O:SYG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
        </CreateFolder>
      </Component>
      <Component Id="ClamAvFolderAcl" Directory="ClamAvDataFolder" Guid="4C1C9C8E-3D6B-4E36-8C1B-7B8E2F0D5A22">
        <CreateFolder>
          <PermissionEx Sddl="O:SYG:SYD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;LS)" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="2A5F7C61-8F0B-4B7A-9D3E-5C6A1E8B4F33">
      <Shortcut Id="AgamemnonShortcut" Name="Agamemnon" Description="Open-source antivirus"
                Target="[#AgamemnonExe]" WorkingDirectory="INSTALLFOLDER" Icon="AgamemnonIcon" />
      <RegistryValue Root="HKLM" Key="Software\Agamemnon" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Event Log source for the services (LocalService may not create one itself). -->
    <Component Id="EventLogSource" Directory="INSTALLFOLDER" Guid="9B3D2E14-6C7F-4A85-B1E2-3F4A5B6C7D44">
      <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\Agamemnon"
                     Name="EventMessageFile" Type="expandable"
                     Value="%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" KeyPath="yes" />
    </Component>

    <!-- Safety net on uninstall: the service restores DNS when it stops; this runs the same
         restore once more after the services have stopped, in case the service was broken. -->
    <CustomAction Id="RestoreDns" FileRef="ServiceExe" ExeCommand="--restore-dns" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RestoreDns" After="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
