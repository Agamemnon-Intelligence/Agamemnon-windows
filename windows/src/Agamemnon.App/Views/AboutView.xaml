<UserControl x:Class="Agamemnon.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels">
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Image Source="/Assets/agamemnon-256.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TitleText}" Text="Agamemnon" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Version}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="Open-source antivirus for Windows and Mac: encrypted DNS, malware scanning, archive and installer scanning, unsafe-download blocking and administrator-rights alerts." />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,12,0,0">
                        <Run Text="Free software under the" />
                        <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="https://www.gnu.org/licenses/old-licenses/gpl-2.0.html" Foreground="{StaticResource StatusInfoBrush}">GNU General Public License v2</Hyperlink><Run Text=". You may share and change it under the same terms." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="Made by" />
                    <ItemsControl ItemsSource="{Binding Credits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Credit}">
                                <Button Style="{StaticResource LinkButton}" Content="{Binding Name}" HorizontalAlignment="Left" Margin="0,3"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Url}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="Built with" />
                    <ItemsControl ItemsSource="{Binding Components}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Component}">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <Button Style="{StaticResource LinkButton}" Content="{Binding Name}"
                                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Url}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding License}" Margin="10,1,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
