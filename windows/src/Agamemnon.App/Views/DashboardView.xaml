<UserControl x:Class="Agamemnon.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Agamemnon.App.Services"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels"
             xmlns:l="clr-namespace:Agamemnon.App.Localization">
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:Tr dashboard.title}" Margin="0,0,0,20" />

            <!-- Overall status -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" Height="64" Margin="0,0,20,0">
                        <Ellipse Fill="{Binding Main.ProtectionBrush}" Opacity="0.15" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xEA18;" FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{Binding Main.ProtectionBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource HeadingText}" Text="{Binding Main.ProtectionHeadline}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Main.ProtectionDetail}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Center" Command="{Binding QuickScanCommand}" Padding="22,12"
                            ToolTip="{l:Tr scan.quick.tip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" Foreground="{StaticResource ButtonTextBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{l:Tr dashboard.scanNow}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubheading}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 4.0: a newer Agamemnon is available -->
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource StatusInfoBrush}"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Tr update.show}" Command="{Binding OpenCommand}"
                            CommandParameter="{x:Static svc:NavigationTarget.Checkup}" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding UpdateText}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Problems, each with a button that fixes it -->
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource StatusWarningBrush}"
                    Visibility="{Binding HasProblems, Converter={StaticResource Visible}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="{l:Tr dashboard.fixAll}" Command="{Binding Main.FixAllCommand}" VerticalAlignment="Center"
                                Visibility="{Binding CanFixAll, Converter={StaticResource Visible}}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr dashboard.problems.title}" Margin="0" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.problems.hint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Main.Problems}" Style="{StaticResource PlainList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProblemViewModel}">
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,6,10,0" Fill="{Binding Brush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding FixLabel}" Command="{Binding FixCommand}" Style="{StaticResource SecondaryButton}"
                                            VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Quick switches: the everyday protections, one click each -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr dashboard.switches.title}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DownloadProtection}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr dashboard.switch.downloads}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.switch.downloads.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Main.Dns.IsEnabled}" IsEnabled="{Binding Main.Dns.ServiceReady}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr dashboard.switch.dns}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.switch.dns.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RansomwareShield}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr dashboard.switch.ransomware}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.switch.ransomware.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PasteGuard}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr dashboard.switch.paste}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.switch.paste.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AdminRightsAlerts}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr dashboard.switch.admin}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.switch.admin.detail}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Tiles -->
            <UniformGrid Columns="2" Margin="0,0,-16,0">
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="{l:Tr dashboard.tile.dnsLink}" HorizontalAlignment="Left"
                                Command="{Binding OpenCommand}" CommandParameter="{x:Static svc:NavigationTarget.Dns}" Margin="0,8,0,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.tile.dns}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding DnsBrush}" />
                                <TextBlock Style="{StaticResource SubheadingText}" Text="{Binding DnsTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding DnsDetail}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="{l:Tr dashboard.tile.downloadsLink}" HorizontalAlignment="Left"
                                Command="{Binding OpenCommand}" CommandParameter="{x:Static svc:NavigationTarget.Downloads}" Margin="0,8,0,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.tile.downloads}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding DownloadsBrush}" />
                                <TextBlock Style="{StaticResource SubheadingText}" Text="{Binding DownloadsTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding DownloadsDetail}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="{l:Tr dashboard.tile.scanLink}" HorizontalAlignment="Left"
                                Command="{Binding OpenCommand}" CommandParameter="{x:Static svc:NavigationTarget.Scan}" Margin="0,8,0,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.tile.lastScan}" />
                            <TextBlock Style="{StaticResource SubheadingText}" Text="{Binding LastScanTitle}" Margin="0,6,0,4" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding LastScanDetail}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding AutoScanText}" Margin="0,6,0,0" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding EngineText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="{l:Tr dashboard.tile.quarantineLink}" HorizontalAlignment="Left"
                                Command="{Binding OpenCommand}" CommandParameter="{x:Static svc:NavigationTarget.Quarantine}" Margin="0,8,0,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.tile.quarantine}" />
                            <TextBlock Style="{StaticResource SubheadingText}" Text="{Binding QuarantineTitle}" Margin="0,6,0,4" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr dashboard.tile.quarantine.detail}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Threat intelligence: ClamAV + offline hash databases + YARA -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr dashboard.coverage.caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding CoverageBrush}" />
                        <TextBlock Style="{StaticResource SubheadingText}" Text="{Binding CoverageTitle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding CoverageDetail}" />
                    <ProgressBar Height="4" Margin="0,10,0,6" Maximum="100" Value="{Binding CoverageProgress, Mode=OneWay}"
                                 Foreground="{Binding CoverageBrush}" />
                    <ItemsControl ItemsSource="{Binding CoverageSources}" Style="{StaticResource PlainList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding}" Margin="0,2,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent activity: downloads, admin-rights alerts, scans -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr dashboard.activity.title}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr dashboard.activity.empty}"
                               Visibility="{Binding Activity.Count, Converter={StaticResource CollapsedWhen}}" />
                    <ItemsControl ItemsSource="{Binding Activity}" Style="{StaticResource PlainList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:ActivityEntry}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,10,0"
                                             Fill="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" Text="{Binding When}" Margin="12,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
