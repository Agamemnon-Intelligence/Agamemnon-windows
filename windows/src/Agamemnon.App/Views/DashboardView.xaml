<UserControl x:Class="Agamemnon.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:Agamemnon.App.Services"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels">
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="Dashboard" Margin="0,0,0,20" />

            <!-- Overall status -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" Height="64" Margin="0,0,20,0">
                        <Ellipse Fill="{Binding Main.ProtectionBrush}" Opacity="0.15" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xEA18;" FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{Binding Main.ProtectionBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource HeadingText}" Text="{Binding Main.ProtectionHeadline}" />
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Main.ProtectionDetail}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Quick scan" VerticalAlignment="Center" Command="{Binding QuickScanCommand}" />
                </Grid>
            </Border>

            <!-- Tiles -->
            <UniformGrid Columns="2" Margin="0,0,-16,0">
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="DNS settings" HorizontalAlignment="Left"
                                Command="{Binding OpenCommand}" CommandParameter="{x:Static svc:NavigationTarget.Dns}" Margin="0,8,0,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Text="ENCRYPTED DNS" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding DnsBrush}" />
                                <TextBlock Style="{StaticResource SubheadingText}" Text="{Binding DnsTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding DnsDetail}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="Download protection" HorizontalAlignment="Left"
                                Command="{Binding OpenCommand}" CommandParameter="{x:Static svc:NavigationTarget.Downloads}" Margin="0,8,0,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Text="UNSAFE DOWNLOAD BLOCKING" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding DownloadsBrush}" />
                                <TextBlock Style="{StaticResource SubheadingText}" Text="{Binding DownloadsTitle}" Margin="0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding DownloadsDetail}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="Scan options" HorizontalAlignment="Left"
                                Command="{Binding OpenCommand}" CommandParameter="{x:Static svc:NavigationTarget.Scan}" Margin="0,8,0,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Text="LAST SCAN" />
                            <TextBlock Style="{StaticResource SubheadingText}" Text="{Binding LastScanTitle}" Margin="0,6,0,4" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding LastScanDetail}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding EngineText}" Margin="0,6,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="Open quarantine" HorizontalAlignment="Left"
                                Command="{Binding OpenCommand}" CommandParameter="{x:Static svc:NavigationTarget.Quarantine}" Margin="0,8,0,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Text="QUARANTINE" />
                            <TextBlock Style="{StaticResource SubheadingText}" Margin="0,6,0,4">
                                <Run Text="{Binding QuarantineTitle, Mode=OneWay}" /> <Run Text="file(s)" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Quarantined files are encrypted and can't run." />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Recent activity: downloads, admin-rights alerts, scans -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="Recent activity" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="Nothing yet. Downloads, scans and programs that get administrator rights will show up here."
                               Visibility="{Binding Activity.Count, Converter={StaticResource CollapsedWhen}}" />
                    <ItemsControl ItemsSource="{Binding Activity}" Style="{StaticResource PlainList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:ActivityEntry}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,10,0"
                                             Fill="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" Text="{Binding When}" Margin="12,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
