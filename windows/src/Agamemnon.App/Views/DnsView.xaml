<UserControl x:Class="Agamemnon.App.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate x:Key="PresetTile" DataType="{x:Type vm:PresetOption}">
            <RadioButton Style="{StaticResource OptionTile}" GroupName="preset" Width="290" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Description}" TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="Encrypted DNS" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,20"
                       Text="Encrypts every name lookup on this PC so your network and internet provider can't see or change which sites you visit. Applied directly by Agamemnon, with no configuration profile." />

            <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource StatusThreatBrush}"
                    Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Error}" />
            </Border>

            <!-- Live status and one-click on/off -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding ServiceReady}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="Encrypted DNS" Margin="0" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding StatusBrush}" />
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding StatusText}" />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding StatsText}" Margin="0,10,0,0"
                               Visibility="{Binding StatsText, Converter={StaticResource VisibleWhen}}" />
                    <ProgressBar IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Border>

            <!-- Protocol -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="Protocol" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource OptionTile}" GroupName="protocol" Width="290" IsChecked="{Binding IsHttps}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="DNS-over-HTTPS" />
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="Looks like normal web traffic. Handled by Windows 11 itself." />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource OptionTile}" GroupName="protocol" Width="290" IsChecked="{Binding IsTls}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="DNS-over-TLS" />
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="Dedicated encrypted port 853. Handled by Agamemnon's local resolver." />
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Server -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="General" />
                    <ItemsControl ItemsSource="{Binding GeneralPresets}" ItemTemplate="{StaticResource PresetTile}" ItemsPanel="{StaticResource Wrap}" />

                    <StackPanel Margin="0,4,0,12" Visibility="{Binding IsNextDns, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="NextDNS configuration ID (from my.nextdns.io)" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="220" Text="{Binding NextDnsId, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Save" Command="{Binding ApplyCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SubheadingText}" Text="Security filtering" Margin="0,12,0,4" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="These resolvers refuse to look up known malware and phishing domains." Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding FilteringPresets}" ItemTemplate="{StaticResource PresetTile}" ItemsPanel="{StaticResource Wrap}" />

                    <TextBlock Style="{StaticResource SubheadingText}" Text="Custom" Margin="0,12,0,8" />
                    <ContentPresenter Content="{Binding CustomPreset}" ContentTemplate="{StaticResource PresetTile}" HorizontalAlignment="Left" />
                    <Grid Margin="0,4,0,0" Visibility="{Binding IsCustom, Converter={StaticResource Visible}}" MaxWidth="600" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SecondaryText}" Text="Name" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="0,4" Text="{Binding CustomName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource SecondaryText}" Text="DoH URL" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding CustomDohUrl, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="For example https://dns.example.net/dns-query" />
                        <TextBlock Grid.Row="2" Style="{StaticResource SecondaryText}" Text="TLS server name" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding CustomTlsHost, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="For example dns.example.net (used for DNS-over-TLS)" />
                        <TextBlock Grid.Row="3" Style="{StaticResource SecondaryText}" Text="Server IP addresses" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding CustomAddresses, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Comma-separated, e.g. 192.0.2.1, 2001:db8::1" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Save custom server" Command="{Binding ApplyCommand}" />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Text="Windows will ask for administrator approval." />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Rules -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="Turn DNS off on these Wi-Fi networks" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10"
                               Text="Useful for hotel and café networks whose sign-in pages need their own DNS, or networks that already filter DNS." />
                    <ItemsControl ItemsSource="{Binding DisabledNetworks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveNetworkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Width="220" Text="{Binding NewNetwork, UpdateSourceTrigger=PropertyChanged}" ToolTip="Wi-Fi network name" />
                        <Button Content="Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddNetworkCommand}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding AddCurrentNetworkCommand}" Margin="8,0,0,0"
                                Visibility="{Binding CurrentNetwork, Converter={StaticResource VisibleWhen}}">
                            <TextBlock><Run Text="Add “" /><Run Text="{Binding CurrentNetwork, Mode=OneWay}" /><Run Text="”" /></TextBlock>
                        </Button>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SubheadingText}" Text="Excluded domains" Margin="0,24,0,0" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10"
                               Text="These domains and their subdomains are looked up by your network's own DNS, e.g. company intranet names." />
                    <ItemsControl ItemsSource="{Binding ExcludedDomains}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveDomainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Width="220" Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. corp.example.com" />
                        <Button Content="Add" Style="{StaticResource SecondaryButton}" Command="{Binding AddDomainCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Leak test -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Run leak test" Command="{Binding RunLeakTestCommand}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="Leak test" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="Finds out which resolvers actually answer this PC's lookups and who runs them." />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,6" Visibility="{Binding LeakSummary, Converter={StaticResource VisibleWhen}}">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding LeakBrush}" />
                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding LeakSummary}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding LeakResolvers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ResolverRow}">
                                <Grid Margin="18,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Address}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" Text="{Binding Owner}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
