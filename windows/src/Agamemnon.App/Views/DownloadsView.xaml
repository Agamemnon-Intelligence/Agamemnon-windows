<UserControl x:Class="Agamemnon.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels"
             xmlns:svc="clr-namespace:Agamemnon.App.Services"
             xmlns:l="clr-namespace:Agamemnon.App.Localization">
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:Tr downloads.title}" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,20"
                       Text="{l:Tr downloads.intro}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr downloads.block}" Margin="0" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding CheckedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr downloads.folders}" />
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FolderRow}">
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{l:Tr downloads.stopWatching}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource Visible}}"
                                            Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Path}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{l:Tr common.addFolder}" Style="{StaticResource SecondaryButton}" Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr downloads.unsigned.title}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10"
                               Text="{l:Tr downloads.unsigned.detail}" />
                    <WrapPanel>
                        <RadioButton Style="{StaticResource OptionTile}" GroupName="unsigned" Width="290" IsChecked="{Binding WarnUnsigned}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr downloads.unsigned.warn}" />
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="{l:Tr downloads.unsigned.warn.detail}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource OptionTile}" GroupName="unsigned" Width="290" IsChecked="{Binding BlockUnsigned}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr downloads.unsigned.block}" />
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="{l:Tr downloads.unsigned.block.detail}" />
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckSource}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Text="{l:Tr downloads.source}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr downloads.source.detail}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr downloads.recent}" />
                    <ItemsControl ItemsSource="{Binding RecentDownloads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:ActivityEntry}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,10,0"
                                             Fill="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" Text="{Binding When}" Margin="12,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
