<UserControl x:Class="Agamemnon.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels"
             xmlns:l="clr-namespace:Agamemnon.App.Localization">
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:Tr help.title}" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,20" Text="{l:Tr help.intro}" />

            <!-- The three things most people come here for -->
            <Border Style="{StaticResource Card}">
                <WrapPanel>
                    <Button Content="{l:Tr help.action.scan}" Command="{Binding QuickScanCommand}" Margin="0,0,8,0" />
                    <Button Content="{l:Tr help.action.welcome}" Style="{StaticResource SecondaryButton}" Command="{Binding ShowWelcomeCommand}" Margin="0,0,8,0" />
                    <Button Content="{l:Tr help.action.report}" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLinkCommand}"
                            CommandParameter="https://github.com/Agamemnon-Intelligence/Agamemnon-Windows/issues" />
                </WrapPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Topics}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HelpTopic}">
                        <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Question}" />
                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Answer}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
