<UserControl x:Class="Agamemnon.App.Views.ProtectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels"
             xmlns:svc="clr-namespace:Agamemnon.App.Services"
             xmlns:l="clr-namespace:Agamemnon.App.Localization">
    <!-- 4.0: real-time protection beyond downloads, one switch per guard. -->
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:Tr protection.title}" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,20" Text="{l:Tr protection.intro}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr protection.files.title}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding OnAccessScanning}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.onAccess}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.onAccess.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding OnAccessText}" Margin="52,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr protection.ransomware}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RansomwareShield}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.ransomware.switch}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.ransomware.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StopDangerousPrograms}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.stop}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.stop.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.ransomware.folders}" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FolderRow}">
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{l:Tr common.remove}"
                                            Visibility="{Binding CanRemove, Converter={StaticResource Visible}}"
                                            Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Path}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{l:Tr common.addFolder}" Style="{StaticResource SecondaryButton}" Command="{Binding AddFolderCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.ransomware.backup}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr protection.paste}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PasteGuard}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.paste.switch}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.paste.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PasteGuardClears}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.paste.clear}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.paste.clear.detail}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr protection.usb}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UsbProtection}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.usb.switch}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.usb.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EjectInfectedDrives}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.usb.eject}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.usb.eject.detail}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr protection.more}" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PrivacyAlerts}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.privacy}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.privacy.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartupAlerts}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.startup}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.startup.detail}" />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SettingsLock}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{l:Tr protection.lock}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr protection.lock.detail}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr protection.recent}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="{l:Tr protection.recent.empty}"
                               Visibility="{Binding Incidents.IsEmpty, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding Incidents}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:ActivityEntry}">
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,5,10,0"
                                             Fill="{Binding Level, Converter={StaticResource LevelBrush}}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{StaticResource BodyText}" Text="{Binding Title}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Detail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" Text="{Binding When}" Margin="12,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
