<UserControl x:Class="Agamemnon.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels">
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Delete all" Style="{StaticResource DangerButton}" Command="{Binding DeleteAllCommand}" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource CollapsedWhen}}" />
                <TextBlock Style="{StaticResource TitleText}" Text="Quarantine" />
            </DockPanel>
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,20"
                       Text="Quarantined files are encrypted and locked away, so they can't run or be opened. Restore a file only if you're sure it's safe." />

            <Border Style="{StaticResource Banner}" BorderBrush="{StaticResource StatusInfoBrush}"
                    Visibility="{Binding Message, Converter={StaticResource VisibleWhen}}">
                <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}" />
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,24">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" FontSize="32" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Text="Quarantine is empty." Margin="0,12,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:QuarantineRow}">
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Brush}" VerticalAlignment="Top" Margin="0,6,12,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding FileName}" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Reason}" Margin="0,2,0,2" />
                                    <TextBlock Style="{StaticResource CaptionText}">
                                        <Run Text="{Binding Source, Mode=OneWay}" /> · <Run Text="{Binding When, Mode=OneWay}" /> · <Run Text="{Binding OriginalPath, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <Button Content="Restore" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}" Margin="0,0,8,0" />
                                    <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
