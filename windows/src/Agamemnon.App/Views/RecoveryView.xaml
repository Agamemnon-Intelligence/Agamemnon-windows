<UserControl x:Class="Agamemnon.App.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels"
             xmlns:l="clr-namespace:Agamemnon.App.Localization">
    <!-- 5.0: restore points and earlier copies of files, for getting things back after ransomware. -->
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:Tr recovery.title}" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,20" Text="{l:Tr recovery.intro}" />

            <!-- After the ransomware shield stepped in -->
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource StatusThreatBrush}"
                    Visibility="{Binding HasIncident, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr recovery.incident.title}" />
                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding IncidentText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="{l:Tr recovery.incident.restore}" Command="{Binding RestoreIncidentCommand}" IsEnabled="{Binding IsIdle}" />
                        <Button Content="{l:Tr recovery.incident.dismiss}" Style="{StaticResource SecondaryButton}" Command="{Binding DismissIncidentCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Message}" Foreground="{Binding MessageBrush}" Margin="4,0,0,12" TextWrapping="Wrap" />

            <!-- Earlier copies of one file -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr recovery.file.title}" />
                    <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr recovery.file.detail}" Margin="0,0,0,8" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:Tr recovery.file.find}" Command="{Binding FindVersionsCommand}" IsEnabled="{Binding IsIdle}" Margin="10,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="{l:Tr recovery.file.choose}" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseFileCommand}" IsEnabled="{Binding IsIdle}" Margin="10,0,0,0" />
                        <TextBox Text="{Binding SelectedFile, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Versions}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FileVersionRow}">
                                <DockPanel Margin="0,6">
                                    <Button DockPanel.Dock="Right" Content="{l:Tr recovery.version.restore}" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding RestoreCommand}" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding When}" />
                                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Detail}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Restore points -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{l:Tr recovery.create}" Command="{Binding CreatePointCommand}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="{l:Tr recovery.points.title}" Margin="0" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding PointsSummary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Points}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RestorePointRow}">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource StatusProtectedBrush}" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding When}" Margin="0,0,10,0" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Detail}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr recovery.points.note}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
