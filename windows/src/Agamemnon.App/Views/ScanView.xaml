<UserControl x:Class="Agamemnon.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="Scan" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,20"
                       Text="ClamAV signatures, YARA rules, hash reputation and code-signature checks. Archives, disk images and installers are unpacked and their contents scanned too. You can also drop files here." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="Quick scan" Command="{Binding QuickScanCommand}" Margin="0,0,8,8"
                                ToolTip="Downloads, Desktop, Startup folders and temporary files" />
                        <Button Content="Full scan" Command="{Binding FullScanCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"
                                ToolTip="Every fixed drive. This can take a long time." />
                        <Button Content="Scan files…" Command="{Binding ScanFilesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                        <Button Content="Scan folders…" Command="{Binding ScanFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                    </WrapPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProgressText}" />
                            <ProgressBar IsIndeterminate="True" Margin="0,8,0,6" Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Stop" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" VerticalAlignment="Top"
                                Margin="16,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Banner}">
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,12" Visibility="{Binding Summary, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SubheadingText}" Text="{Binding Summary}" Margin="0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Quarantine all threats" Command="{Binding QuarantineAllThreatsCommand}"
                        Visibility="{Binding UnresolvedThreats, Converter={StaticResource VisibleWhen}}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding Brush}" CornerRadius="{StaticResource RadiusSmall}" Padding="8,2" Margin="0,0,14,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding VerdictText}" Foreground="{StaticResource BackgroundBrush}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding FileName}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Location}" Margin="0,2,0,6" />
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource StatusProtectedBrush}" Text="{Binding Status}" Margin="0,6,0,0"
                                               Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0"
                                            Visibility="{Binding CanAct, Converter={StaticResource Visible}}">
                                    <Button Content="Show" Style="{StaticResource SecondaryButton}" Command="{Binding RevealCommand}" Margin="0,0,8,0" />
                                    <Button Content="Trust" Style="{StaticResource SecondaryButton}" Command="{Binding TrustCommand}" Margin="0,0,8,0"
                                            ToolTip="Don't flag this exact file again" />
                                    <Button Content="Quarantine" Command="{Binding QuarantineCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
