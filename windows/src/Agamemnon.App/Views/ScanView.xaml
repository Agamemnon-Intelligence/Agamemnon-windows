<UserControl x:Class="Agamemnon.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels"
             xmlns:l="clr-namespace:Agamemnon.App.Localization"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="{l:Tr scan.title}" />
            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,0,0,20" Text="{l:Tr scan.intro}" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Three plain choices; the recommended one comes first and stands out. -->
                    <UniformGrid Columns="3" Margin="0,0,-10,0">
                        <Button Command="{Binding QuickScanCommand}" HorizontalContentAlignment="Left" Padding="16,14" Margin="0,0,10,0"
                                VerticalAlignment="Stretch" ToolTip="{l:Tr scan.quick.tip}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr scan.quick}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubheading}" />
                                <TextBlock Text="{l:Tr scan.quick.detail}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding FullScanCommand}" Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left"
                                Padding="16,14" Margin="0,0,10,0" VerticalAlignment="Stretch" ToolTip="{l:Tr scan.full.tip}">
                            <StackPanel>
                                <TextBlock Text="{l:Tr scan.full}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubheading}" />
                                <TextBlock Text="{l:Tr scan.full.detail}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}"
                                Padding="16,14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource BodyText}" Text="{l:Tr scan.custom}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSubheading}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{l:Tr scan.custom.detail}" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <WrapPanel>
                                    <Button Content="{l:Tr scan.files}" Command="{Binding ScanFilesCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,6" />
                                    <Button Content="{l:Tr scan.folders}" Command="{Binding ScanFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="10,5" Margin="0,0,6,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding ProgressText}" />
                            <ProgressBar IsIndeterminate="True" Margin="0,8,0,6" Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{l:Tr scan.stop}" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" VerticalAlignment="Top"
                                Margin="16,0,0,0" Visibility="{Binding IsScanning, Converter={StaticResource Visible}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Banner}">
                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,4,0,12" Visibility="{Binding Summary, Converter={StaticResource VisibleWhen}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SubheadingText}" Text="{Binding Summary}" Margin="0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{l:Tr scan.quarantineAll}" Command="{Binding QuarantineAllThreatsCommand}"
                        Visibility="{Binding UnresolvedThreats, Converter={StaticResource VisibleWhen}}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Findings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{Binding Brush}" CornerRadius="{StaticResource RadiusSmall}" Padding="8,2" Margin="0,0,14,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding VerdictText}" Foreground="{StaticResource BackgroundBrush}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding FileName}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Location}" Margin="0,2,0,6" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Advice}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding}" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource StatusProtectedBrush}" Text="{Binding Status}" Margin="0,6,0,0"
                                               Visibility="{Binding Status, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0"
                                            Visibility="{Binding CanAct, Converter={StaticResource Visible}}">
                                    <Button Content="{l:Tr finding.show}" ToolTip="{l:Tr finding.show.tip}" Style="{StaticResource SecondaryButton}" Command="{Binding RevealCommand}" Margin="0,0,8,0" />
                                    <Button Content="{l:Tr finding.trust}" Style="{StaticResource SecondaryButton}" Command="{Binding TrustCommand}" Margin="0,0,8,0"
                                            ToolTip="{l:Tr finding.trust.tip}" />
                                    <Button Content="{l:Tr finding.quarantine}" Command="{Binding QuarantineCommand}" ToolTip="{l:Tr finding.quarantine.tip}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
