<UserControl x:Class="Agamemnon.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Agamemnon.App.ViewModels">
    <ScrollViewer Style="{StaticResource Page}">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource TitleText}" Text="Settings" Margin="0,0,0,20" />

            <!-- Hash lookups -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HashLookups}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="Hash lookups" Margin="0" />
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                                       Text="Check programs, installers, scripts, documents and archives against known malware by their SHA-256 fingerprint. Only the fingerprint is sent, never the file." />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="MalwareBazaar (abuse.ch) Auth-Key" Margin="0,20,0,4" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8">
                        <Run Text="Free. Get one at" />
                        <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="https://auth.abuse.ch/" Foreground="{StaticResource StatusInfoBrush}">auth.abuse.ch</Hyperlink>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasMalwareBazaarKey, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource BodyText}" Text="✓ Key saved (encrypted for your Windows account)" VerticalAlignment="Center" Foreground="{StaticResource StatusProtectedBrush}" />
                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveMalwareBazaarKeyCommand}" Margin="12,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasMalwareBazaarKey, Converter={StaticResource CollapsedWhen}}">
                        <TextBox Width="360" Text="{Binding NewMalwareBazaarKey, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Save" Command="{Binding SaveMalwareBazaarKeyCommand}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="VirusTotal API key (optional)" Margin="0,20,0,4" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,8">
                        <Run Text="Your own key from" />
                        <Hyperlink Command="{Binding OpenLinkCommand}" CommandParameter="https://www.virustotal.com/gui/my-apikey" Foreground="{StaticResource StatusInfoBrush}">virustotal.com</Hyperlink>
                        <Run Text=". The free tier allows 4 lookups a minute; extra files are skipped, not delayed." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasVirusTotalKey, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource BodyText}" Text="✓ Key saved (encrypted for your Windows account)" VerticalAlignment="Center" Foreground="{StaticResource StatusProtectedBrush}" />
                        <Button Content="Remove" Style="{StaticResource SecondaryButton}" Command="{Binding RemoveVirusTotalKeyCommand}" Margin="12,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasVirusTotalKey, Converter={StaticResource CollapsedWhen}}">
                        <TextBox Width="360" Text="{Binding NewVirusTotalKey, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Save" Command="{Binding SaveVirusTotalKeyCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Alerts and startup -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AdminRightsAlerts}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="Administrator-rights alerts" Margin="0" />
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                                       Text="Tell me when a program gets administrator rights or installs a system service, with who signed it and whether it's known malware." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartAtLogin}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SubheadingText}" Text="Start with Windows" Margin="0" />
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0"
                                       Text="Download protection and alerts only work while Agamemnon is running in the notification area." />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Scanning -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshEnginesCommand}" VerticalAlignment="Top" />
                        <TextBlock Style="{StaticResource SubheadingText}" Text="Scan engines" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Engines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EngineRow}">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding Brush}" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding Name}" Width="150" />
                                    <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,8"
                               Text="ClamAV signatures update automatically every two hours. Add your own YARA rules (.yar) to the rules folder." />
                    <Button Content="Open YARA rules folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenRulesFolderCommand}" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Folders left out of scans" Margin="0,20,0,6" />
                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add folder…" Style="{StaticResource SecondaryButton}" Command="{Binding AddExclusionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />

                    <DockPanel Margin="0,20,0,0">
                        <Button DockPanel.Dock="Right" Content="Forget all" Style="{StaticResource SecondaryButton}" Command="{Binding ClearTrustedCommand}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Trusted files" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding TrustedText}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Button Style="{StaticResource LinkButton}" Content="About Agamemnon" Command="{Binding ShowAboutCommand}" HorizontalAlignment="Left" Margin="0,0,0,24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
