<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- One executable, two Windows services:
         Agamemnon            (LocalSystem)  encrypted DNS, administrator-rights alerts, IPC
         AgamemnonScanEngine  (LocalService) runs ClamAV's clamd and keeps signatures updated
       plus a restore-dns command line run by the uninstaller. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Agamemnon.Service</RootNamespace>
    <AssemblyName>Agamemnon.Service</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Agamemnon.Core/Agamemnon.Core.csproj" />
    <ProjectReference Include="../Agamemnon.Platform.Windows/Agamemnon.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
